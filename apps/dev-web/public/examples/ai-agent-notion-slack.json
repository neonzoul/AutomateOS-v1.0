{
  "meta": {
    "name": "AI Agent with Notion & Slack",
    "version": 1,
    "description": "AI-powered workflow that processes data, creates Notion entries, and sends Slack notifications",
    "exportedAt": "2025-10-01T10:00:00.000Z"
  },
  "nodes": [
    {
      "id": "start-1",
      "type": "start",
      "position": {
        "x": 100,
        "y": 300
      },
      "data": {
        "label": "Start",
        "config": {}
      }
    },
    {
      "id": "notion-1",
      "type": "http",
      "position": {
        "x": 350,
        "y": 200
      },
      "data": {
        "label": "Create Notion Page",
        "icon": "notion",
        "description": "Amet minim mollit non deserunt ullamco est sit aliqua dolor do amet sint. Velit officia consequat duis enim velit mollit.",
        "tags": ["Tag", "Tag", "Tag"],
        "config": {
          "method": "POST",
          "url": "https://api.notion.com/v1/pages",
          "headers": {
            "Content-Type": "application/json",
            "Notion-Version": "2022-06-28"
          },
          "json_body": {
            "parent": {
              "database_id": "your-database-id"
            },
            "properties": {
              "Name": {
                "title": [
                  {
                    "text": {
                      "content": "AI Generated Entry"
                    }
                  }
                ]
              }
            }
          },
          "auth": {
            "credentialName": "notion-integration-token"
          }
        }
      }
    },
    {
      "id": "condition-1",
      "type": "condition",
      "position": {
        "x": 850,
        "y": 280
      },
      "data": {
        "label": "If/Else",
        "config": {
          "condition": "success"
        }
      }
    },
    {
      "id": "agent-1",
      "type": "agent",
      "position": {
        "x": 1050,
        "y": 80
      },
      "data": {
        "label": "AI Agent",
        "description": "Conversational AI agent with model, memory, and tools",
        "tags": ["AI", "Agent", "LLM"],
        "config": {
          "model": "gpt-4",
          "temperature": 0.7,
          "systemPrompt": "You are a helpful AI assistant that processes workflow data."
        },
        "isCollapsed": false
      }
    },
    {
      "id": "slack-1",
      "type": "http",
      "position": {
        "x": 1600,
        "y": 30
      },
      "data": {
        "label": "Slack",
        "icon": "slack",
        "description": "Amet minim mollit non deserunt ullamco est sit aliqua dolor do amet sint. Velit officia consequat duis enim velit mollit.",
        "tags": ["Tag", "Tag", "Tag"],
        "config": {
          "method": "POST",
          "url": "https://hooks.slack.com/services/YOUR/WEBHOOK/URL",
          "headers": {
            "Content-Type": "application/json"
          },
          "json_body": {
            "text": "AI Agent workflow completed successfully!"
          }
        }
      }
    },
    {
      "id": "slack-2",
      "type": "http",
      "position": {
        "x": 1050,
        "y": 500
      },
      "data": {
        "label": "Slack",
        "icon": "slack",
        "description": "Amet minim mollit non deserunt ullamco est sit aliqua dolor do amet sint. Velit officia consequat duis enim velit mollit.",
        "tags": ["Tag", "Tag", "Tag"],
        "config": {
          "method": "POST",
          "url": "https://hooks.slack.com/services/YOUR/WEBHOOK/URL",
          "headers": {
            "Content-Type": "application/json"
          },
          "json_body": {
            "text": "Workflow processing error notification"
          }
        }
      }
    }
  ],
  "edges": [
